---
import Base from '../layouts/Base.astro';
import CandidateCard from '../components/CandidateCard.astro';
import CompareTable from '../components/CompareTable.astro';
import { races, url, type Race } from '../lib/data';

export function getStaticPaths() {
  return races.map((race) => ({ params: { race: race.id }, props: { race } }));
}

const { race } = Astro.props as { race: Race };
const n = race.candidates.length;
const wardNumber = race.type === 'ward' ? race.id.replace('ward-', '') : '';
const trusteeRaces = wardNumber ? races.filter((r) => r.type === 'trustee' && r.wards.includes(wardNumber)) : [];
const wardList = (wards: string[]) => (wards.length === 10 ? 'all of Barrie' : `Barrie wards ${wards.slice(0, -1).join(', ')} and ${wards.at(-1)}`);
// Back link returns to this race's section of the home page.
const back = race.type === 'ward' ? { href: url('#wards'), label: 'All wards' }
  : race.type === 'trustee' ? { href: url('#trustees'), label: 'All trustee races' }
  : { href: url(), label: 'All races' };
---
<Base title={race.name} description={`Candidates for ${race.name} in Barrie's 2026 municipal election.`}>
  <a class="back-link" href={back.href}><span aria-hidden="true">←</span> {back.label}</a>
  <h1>{race.name}</h1>

  {race.type === 'trustee' && (
    <p><strong>{race.board}</strong>, representing {wardList(race.wards)}. {race.areaNote} You vote in this race only if you are a supporter of this school board.</p>
  )}

  {race.acclaimed ? (
    <p><strong>Acclaimed.</strong> Only one candidate was certified for this race, so they are elected without a vote and this race will not appear on the ballot.</p>
  ) : n > 0 && (
    <p>{n} certified candidates, listed alphabetically by last name.</p>
  )}

  <aside class="box" aria-label="Fairness">
    <p>Every candidate is researched the same way and shown with the same layout. Positions are paraphrased from the candidate’s own words and always sourced. Where we found nothing, we say so. A longer public record does not mean a candidate has done anything wrong. <a href={url('standards/')}>Our standards</a></p>
  </aside>

  {trusteeRaces.length > 0 && (
    <aside class="box" aria-labelledby="ward-trustees">
      <h2 id="ward-trustees">School board trustee for Ward {wardNumber}</h2>
      <p>You also vote for one trustee, on the school board you support:</p>
      <ul>
        {trusteeRaces.map((t) => <li><a href={url(`${t.id}/`)}>{t.board}</a></li>)}
      </ul>
    </aside>
  )}

  {n === 0 ? (
    <p class="empty">Candidate information for this race is coming soon.</p>
  ) : (
    <>
      <h2>Candidates</h2>
      <div class="cards">
        {race.candidates.map((c) => <CandidateCard candidate={c} raceType={race.type} />)}
      </div>

      <h2>{n > 1 ? 'Compare positions' : 'Positions'}</h2>
      {n > 1 && <p class="muted small">Each issue lists every candidate in the same alphabetical order.</p>}
      <CompareTable candidates={race.candidates} />
    </>
  )}
</Base>
