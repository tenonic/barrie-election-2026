---
import '../styles/global.css';
import { USE_MOCK, lastUpdated, races, url } from '../lib/data';
import Logo from '../components/Logo.astro';

interface Props { title: string; description?: string }
const { title, description = 'A neutral, sourced guide to the candidates in Barrie’s 2026 municipal election.' } = Astro.props;
const fullTitle = title === 'Home' ? 'Barrie Voter Guide 2026' : `${title} · Barrie Voter Guide 2026`;

// Which nav section the current page belongs to; ward pages count as "Wards", trustee pages as "Trustees".
const page = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '');
const trusteePages = races.filter((r) => r.type === 'trustee').map((r) => r.id);
const section = page.startsWith('ward-') ? 'wards' : trusteePages.includes(page) ? 'trustees' : page;
const nav = [
  { key: 'mayor', href: url('mayor/'), label: 'Mayor' },
  { key: 'wards', href: url('#wards'), label: 'Wards' },
  { key: 'trustees', href: url('#trustees'), label: 'Trustees' },
  { key: 'standards', href: url('standards/'), label: 'Our standards' },
  { key: 'sources', href: url('sources/'), label: 'Sources' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="description" content={description} />
    {USE_MOCK && <meta name="robots" content="noindex" />}
    {/* Google Analytics: published site only, never in local or mock previews. */}
    {import.meta.env.PROD && !USE_MOCK && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V1QH2QKZPW"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-V1QH2QKZPW');
        </script>
      </>
    )}
  </head>
  <body>
    {USE_MOCK && (
      <div class="mock-banner" role="note">
        Mock data preview: races without real candidates show fictional ones. Not for publication.
      </div>
    )}
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href={url()} aria-label="Barrie Voter Guide 2026, home"><Logo /></a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={n.key === section ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    {page === '' && (
      <script is:inline>
        // The "Wards" link points to the ward list on the home page; highlight it while that's the target.
        (function () {
          var link = document.querySelector('.site-nav a[href$="#wards"]');
          function update() {
            if (location.hash === '#wards') link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
          update();
          window.addEventListener('hashchange', update);
        })();
      </script>
    )}
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Election day: Monday, October 26, 2026. Last updated {lastUpdated}.</p>
        <p>Not affiliated with the City of Barrie or any candidate or campaign. No endorsements or ratings. <a href={url('standards/')}>How we stay neutral</a>.</p>
      </div>
    </footer>
  </body>
</html>
