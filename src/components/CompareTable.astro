---
import type { Candidate } from '../lib/data';
import { issues } from '../lib/data';
import SourceLinks from './SourceLinks.astro';

interface Props { candidates: Candidate[] }
const { candidates } = Astro.props;
---
<div class="compare">
  {issues.map((issue, i) => (
    <section class="compare-issue" aria-labelledby={`issue-${issue.issue_id}`}>
      <h3 id={`issue-${issue.issue_id}`}>{issue.name}</h3>
      <div class="compare-grid">
        {candidates.map((c) => {
          const p = c.positions[i];
          return (
            <div class="compare-cell">
              <div class="compare-name">{c.name}</div>
              {p.stated ? p.summary : <span class="empty">No stated position found.</span>}
              <SourceLinks sources={p.sources} />
              {p.note && (
                <div class="note">
                  <strong>Context:</strong> {p.note}
                  <SourceLinks sources={p.noteSources} />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  ))}
</div>
